# =====================================================================
# AeroSense AI — Environment Configuration Template
# =====================================================================
# Copy this file to `.env` and configure your settings:
#   cp .env.example .env
#
# NEVER commit your active `.env` file containing secrets to GitHub.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Real AQI Provider Credentials
# ---------------------------------------------------------------------
# Primary Provider: World Air Quality Index (WAQI / aqicn.org)
# To obtain a free personal token:
#   1. Visit https://aqicn.org/data-platform/token/
#   2. Enter your name and email.
#   3. Confirm your email and paste the token below.
#
# If left blank, AeroSense automatically operates in "Zero-Key Mode"
# using Open-Meteo's live satellite & CAMS atmospheric model with no key required!
AQI_API_KEY=

# Preferred provider: 'waqi' (recommended with key) or 'open-meteo' (zero key)
AQI_PROVIDER=waqi

# Telemetry in-memory cache TTL in seconds (prevents hammering API limits)
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------
# 2. Database Connection
# ---------------------------------------------------------------------
# SQLite (default, zero external setup required for local development):
DATABASE_URL=sqlite:///./aerosense.db

# PostgreSQL (optional, for production on Supabase, AWS RDS, Railway, etc.):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/aerosense

# ---------------------------------------------------------------------
# 3. Server & Security Settings
# ---------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
PORT=8000

# Allowed CORS origins for FastAPI (comma-separated or list in config)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# ---------------------------------------------------------------------
# 4. Frontend Client Environment (Vite)
# ---------------------------------------------------------------------
# Points the React frontend to the FastAPI backend API server:
VITE_API_URL=http://localhost:8000/api
